  "authors": ["RoiCheese"],
  "license": "PolyForm-Noncommercial-1.0.0",
  "contact": {
    "homepage": "https://github.com/AdrienPVM/ArkensiaCobblemonMods",
    "sources": "https://github.com/AdrienPVM/ArkensiaCobblemonMods",
    "issues": "https://github.com/AdrienPVM/ArkensiaCobblemonMods/issues"
  },
  "environment": "server",
  "entrypoints": {
    "main": ["com.cheesepatrol.CheesePatrolMod"],
    "cheesedash": ["com.cheesepatrol.dashboard.CheesePatrolDashboardModule"]
  },
  "mixins": [
    "cheesepatrol.mixins.json"
