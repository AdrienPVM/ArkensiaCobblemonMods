{
  "schemaVersion": 1,
  "id": "cobbleshift",
  "version": "${version}",
  "name": "CobbleShift",
  "description": "Transform players into Pokémon with passive abilities, plus mini-games (CobbleHunt, Hot Potato)",
  "authors": ["RoiCheese"],
  "contact": {
    "homepage": "https://github.com/AdrienPVM/ArkensiaCobblemonMods",
    "sources": "https://github.com/AdrienPVM/ArkensiaCobblemonMods",
    "issues": "https://github.com/AdrienPVM/ArkensiaCobblemonMods/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
