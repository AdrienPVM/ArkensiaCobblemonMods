  "environment": "*",
  "entrypoints": {
    "main": [
      "com.cobbleshift.CobbleShiftMod"
    ],
    "client": [
      "com.cobbleshift.client.CobbleShiftClient"
    ],
    "cheesedash": [
      "com.cobbleshift.dashboard.CobbleShiftDashboardModule"
    ]
  },
  "mixins": [
    "cobbleshift.mixins.json"
